# LLM API Configuration (OpenAI or compatible provider like Groq/AgentRouter)
AGENT_ROUTER_API_KEY=your_llm_api_key_here
BASE_URL="https://api.groq.com/openai/v1"
MODEL="openai/gpt-oss-120b"

# Document Path to index (.pdf, .docx, or .txt)
DOCUMENT="path/to/your/document.docx"

# Local ChromaDB directory path (Optional, defaults to ./rag_db)
DB_PATH="./rag_db"

# TypeSafe AI Jev API Key (Optional: enables intelligent gating & chunk filtering)
TYPESAFE_API_KEY="your_typesafe_api_key_here"
